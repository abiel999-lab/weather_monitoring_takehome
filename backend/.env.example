APP_NAME="Weather Monitor API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=weather_monitor
DB_USERNAME=weather
DB_PASSWORD=weather

CACHE_STORE=database
QUEUE_CONNECTION=sync

FRONTEND_URL=http://localhost:3000
SANCTUM_EXPIRATION=480

SEED_ADMIN_NAME="Demo Reviewer"
SEED_ADMIN_EMAIL=reviewer@example.test
SEED_ADMIN_PASSWORD=ChangeThisLocalOnly123!

# Default reviewer mode (no external key required). For real Groq AI, use AI_PROVIDER=groq, AI_MODEL=openai/gpt-oss-20b, and AI_BASE_URL=https://api.groq.com/openai/v1.
AI_PROVIDER=mock
AI_MODEL=mock-weather-narrator
AI_API_KEY=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=15
AI_FALLBACK_TO_MOCK=true
AI_CACHE_TTL_SECONDS=900
